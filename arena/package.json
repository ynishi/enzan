{
  "name": "enzan-arena",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.sim.json --noEmit && tsc -p tsconfig.test.json --noEmit && vite build",
    "emit": "rm -rf build-sim && tsc -p tsconfig.test.json",
    "test": "npm run emit && node --test 'build-sim/test/**/*.test.js'"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "acorn": "8.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
